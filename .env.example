# Copy to .env and fill in locally. Never commit .env.
#
# Use your Alpaca **paper** API keys. This repository can only ever reach
# Alpaca's paper environment: the trading client is constructed with
# paper=True hardcoded, and there is no flag, option, or environment variable
# that selects live trading (docs/SPEC.md sections 6B, 6C).
#
# Crypto market data does NOT require credentials: `autotrader.cli download`
# works without them. When both are set they are used, which raises the
# provider's rate limit. Alpaca paper order submission
# (`autotrader.cli paper-submit`) does require them.
#
# **Stock** market data DOES require them. Alpaca does not serve equity bars,
# equity latest trades, or the market calendar unauthenticated, so
# `autotrader.cli equity-download` and `autotrader.cli equity-run` both need
# both variables set. The stock feed used is `iex`, which is what an Alpaca
# Basic subscription is entitled to; `sip` needs a paid data plan.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Gate on broker order submission. Disabled unless it is exactly `true`.
#
# Missing, empty, `false`, `TRUE`, `1`, `yes`, or anything else all leave
# submission DISABLED - the gate fails closed, so a typo can never enable it.
# Read-only commands and `paper-submit --dry-run` ignore this gate entirely.
#
# This only ever enables PAPER trading. There is no live equivalent, and
# adding one is a scope change requiring an edit to docs/SPEC.md.
#
# The gate is shared by both products and is never enough on its own:
#   `paper-submit`  additionally requires `--confirm-paper PAPER`
#   `crypto-run`    additionally requires `--confirm-paper-runtime PAPER` and a
#                   startup reconciliation that reports safe_to_trade
#   `equity-run`    requires those two AND the US regular market session to be
#                   open at the moment of submission
# The gates are independent and none can satisfy another.
AUTOTRADER_PAPER_TRADING_ENABLED=false
