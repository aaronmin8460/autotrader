# AutoTrader Equity EDA-1 PAPER - shared, non-secret configuration.
#
# Install to /etc/autotrader/autotrader-equity-paper.env
#   owner  root:root
#   mode   0644
#
# World-readable on purpose: everything here is a path, a policy name or a SAFE
# DEFAULT, and keeping the credentials somewhere else is what lets this file be
# reviewed casually.
#
# systemd parses this itself, not a shell. `KEY=value`, one per line, no
# `export`, no command substitution, no expansion of one variable into another.

# ---------------------------------------------------------------------------
# Stores
# ---------------------------------------------------------------------------

# This runtime's OWN operational database, at the schema its lineage declares.
# It is deliberately not /var/lib/autotrader/autotrader.db: that store is schema
# 6 and belongs to the crypto service, and a process from this lineage opening
# it would migrate it to schema 7 and leave the crypto service unable to open
# its own file.
AUTOTRADER_EQUITY_PAPER_DB=/var/lib/autotrader-equity-paper/equity-paper.db

# The shadow store, read-only. Every bar's EDA-1 answer is compared against the
# independently computed shadow row before anything may be submitted.
AUTOTRADER_EQUITY_SHADOW_DB=/var/lib/autotrader-equity-shadow/equity-shadow.db

# The crypto store, read-only, for its account safety row only. One paper
# account carries both books: an ambiguous crypto order must stop this runtime
# too. Read with a read-only URI and a single SELECT; never migrated.
AUTOTRADER_CRYPTO_DB=/var/lib/autotrader/autotrader.db

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# Binds 127.0.0.1 only. Not reachable from outside the machine without the
# reverse proxy in front of it.
AUTOTRADER_EQUITY_PAPER_API_PORT=8002

# ---------------------------------------------------------------------------
# The realized-P&L accounting ledger
# ---------------------------------------------------------------------------
#
# Its own database, with its own schema and its own version counter, written
# only by autotrader-equity-accounting.service and read only by the paper API.
#
# It is deliberately not a set of tables in the operational store above. Every
# command in the trading lineage migrates a store upward when it opens it, so
# accounting tables in that schema would mean a version bump that migrates a
# running trader's database out from under it. A separate file cannot do that.
#
# Nothing that decides a trade reads this path.
AUTOTRADER_EQUITY_ACCOUNTING_DB=/var/lib/autotrader-accounting/equity-accounting.db

# ---------------------------------------------------------------------------
# The frozen sizing policy
# ---------------------------------------------------------------------------
#
# The shared-account allocation policy, frozen by the sizing validation study.
# The runtime has no default and refuses to start without one: a default here
# would be a sizing policy nobody selected, which is the failure this whole
# module exists to prevent.
AUTOTRADER_EQUITY_PAPER_SIZING_POLICY=C_RESERVED_UNIVERSE

# ---------------------------------------------------------------------------
# THE SAFE DEFAULTS
# ---------------------------------------------------------------------------
#
# The rollout stage selects the EXECUTION universe. The decision universe is
# always all ten symbols - the EDA-1 overlay replays the whole stored series on
# every bar, so a gap in one symbol's series is not a smaller record, it is an
# unreproducible one.
#
#   A  SPY
#   B  SPY, QQQ, IWM
#   C  all ten
#
# A host that has been deployed but never deliberately advanced runs at A.
AUTOTRADER_EQUITY_PAPER_STAGE=A

# The environment gate on broker order submission. The code accepts exactly the
# string `true` and treats missing, empty, `TRUE`, `1`, `yes` and anything else
# as disabled, so a typo can only ever fail closed.
#
# Do not edit this to turn trading on. Activation lives in
# /etc/autotrader/autotrader-equity-paper.trading.env, which the unit loads
# after this file, because the off switch is deleting that file and it cannot
# delete a `true` written here.
AUTOTRADER_PAPER_TRADING_ENABLED=false

# Extra arguments appended to ExecStart. Without --confirm-paper-runtime the
# runtime refuses to start at all, so this is the second closed gate.
AUTOTRADER_EQUITY_PAPER_ARGS=
