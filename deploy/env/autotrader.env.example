# Shared, non-secret AutoTrader deployment configuration.
#
# Install to /etc/autotrader/autotrader.env
#   owner  root:root
#   mode   0644
#
# This file holds no credential and no authorization. It is world-readable on
# purpose: everything in it is a path, a port, or a SAFE DEFAULT, and keeping
# the secrets somewhere else is what lets this one be reviewed casually.
#
# systemd parses this itself, not a shell. `KEY=value`, one per line, no
# `export`, no command substitution, no expansion of one variable into
# another.

# ---------------------------------------------------------------------------
# Persistent state
# ---------------------------------------------------------------------------

# The one operational database. Both trading runtimes write it and the
# dashboard reads it; there is exactly one, and it lives outside the
# application directory so that redeploying code cannot touch it.
#
# /var/lib/autotrader is created and owned by systemd via `StateDirectory=`,
# so it exists with the right ownership before any ExecStart runs.
AUTOTRADER_DB=/var/lib/autotrader/autotrader.db

# The dashboard API reads the same file, under its own variable name.
AUTOTRADER_DASHBOARD_DB=/var/lib/autotrader/autotrader.db

AUTOTRADER_BACKUP_DIR=/var/lib/autotrader/backups
AUTOTRADER_BACKUP_KEEP=7

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# Both bind 127.0.0.1. Neither is reachable from outside the machine without a
# reverse proxy in front (deploy/caddy/Caddyfile, installed by
# autotrader-publish-web).
AUTOTRADER_DASHBOARD_API_PORT=8000
AUTOTRADER_DASHBOARD_WEB_PORT=3000

# ---------------------------------------------------------------------------
# THE SAFE DEFAULTS
# ---------------------------------------------------------------------------
#
# Everything below is the closed position of a gate. A host that has been
# deployed but never deliberately activated runs with exactly these values,
# and with them the runtimes observe: they fetch bars, validate them, evaluate
# the strategy, record signals and reconcile at startup, and submit nothing.
#
# `autotrader-enable-paper-trading` opens the gates by writing a *separate*
# file, /etc/autotrader/autotrader.trading.env, which the runtime units load
# after this one.
#
# **Do not edit these three values to turn trading on.** Turning them on here
# works, and that is the problem: the off switch is `--disable`, which deletes
# the activation file, and it cannot delete a `true` you wrote in this one.
# The host would look deactivated and keep trading. The on switch and the off
# switch have to act on the same file, so activation lives in that file only.
#
# `autotrader-deploy` installs this file when it is absent and leaves an
# existing one alone, so a port or path you change here survives a deploy.

# The environment gate on broker order submission. The code accepts exactly
# the string `true` and treats missing, empty, `TRUE`, `1`, `yes` and anything
# else as disabled, so a typo can only ever fail closed.
AUTOTRADER_PAPER_TRADING_ENABLED=false

# Extra arguments appended to each runtime's ExecStart. `--observe-only` is
# stronger than the gate above: it constructs no execution path at all, so
# submission is not refused, it is unavailable. This is the OBSERVE-ONLY
# STAGING posture described in docs/DEPLOYMENT.md.
#
# Activation replaces these with `--confirm-paper-runtime PAPER`.
AUTOTRADER_CRYPTO_ARGS=--observe-only
AUTOTRADER_EQUITY_ARGS=--observe-only
