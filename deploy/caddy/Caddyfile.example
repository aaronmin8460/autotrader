# OPTIONAL reverse proxy for the AutoTrader dashboard.
#
# Nothing in this repository installs, starts, or configures Caddy, and the
# dashboard does not need it: both dashboard processes bind 127.0.0.1, so on a
# freshly deployed host the dashboard is reachable over an SSH tunnel and from
# nowhere else. That is a perfectly good place to stop.
#
#   ssh -N -L 3000:127.0.0.1:3000 you@your-vps
#   # then open http://127.0.0.1:3000
#
# This file is for the case where you want it on a real hostname instead. Copy
# to /etc/caddy/Caddyfile, fill in the two placeholders, and read the warning
# about authentication before you reload.
#
# ---------------------------------------------------------------------------
# THE DASHBOARD HAS NO AUTHENTICATION OF ITS OWN
# ---------------------------------------------------------------------------
#
# Every route is a GET and nothing it exposes can place an order, so the risk
# is disclosure rather than control - but what it discloses is your account
# value, your positions, your orders and your strategy's behaviour, in real
# time, to anyone who finds the hostname. There is no login page behind this
# proxy to fall back on. The `basic_auth` block below is the entire
# authentication boundary, and removing it publishes the account.
#
# Replace the placeholders:
#
#   {$AUTOTRADER_DASHBOARD_DOMAIN}   the hostname you control, e.g. dash.example.com
#   {$AUTOTRADER_DASHBOARD_USER}     a username you choose
#   the bcrypt hash below            generate with: caddy hash-password
#
# Caddy reads {$VAR} placeholders from its own environment, so the first two
# can come from /etc/default/caddy or a systemd drop-in rather than being
# written here. The password hash is a hash, not a password, but it still does
# not belong in Git: generate it on the server.

{$AUTOTRADER_DASHBOARD_DOMAIN} {
	# Caddy provisions and renews a certificate automatically over ACME. This
	# is the only reason the host needs port 80 open: HTTP-01 validation and
	# the redirect to HTTPS.
	encode gzip

	basic_auth {
		# caddy hash-password  ->  paste the $2a$... string here.
		# The placeholder below is not a usable hash and will refuse every
		# login, which is the correct failure mode for a value nobody set.
		{$AUTOTRADER_DASHBOARD_USER} REPLACE_WITH_BCRYPT_HASH_FROM_CADDY_HASH_PASSWORD
	}

	# One upstream, not two. The Next.js server already rewrites
	# /api/dashboard/* to the FastAPI process on 127.0.0.1:8000, so proxying
	# the frontend is enough to make the whole dashboard work.
	#
	# Do NOT add a second route that proxies the API directly. It would be a
	# path that reaches the unauthenticated backend, and the moment its
	# matcher and the basic_auth matcher disagree - which is a one-character
	# mistake - the account data is public.
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The dashboard is first-party and self-contained; it loads nothing
		# from anywhere else.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		-Server
	}

	log {
		output file /var/log/caddy/autotrader-dashboard.log
		format json
	}
}

# ---------------------------------------------------------------------------
# Firewall, if this block is in use
# ---------------------------------------------------------------------------
#
#   ufw default deny incoming
#   ufw allow OpenSSH
#   ufw allow 80/tcp       # ACME HTTP-01 and the redirect to HTTPS
#   ufw allow 443/tcp
#   ufw enable
#
# Nothing else is opened. Specifically:
#
#   * 8000 (dashboard API) and 3000 (frontend) stay on loopback. If either is
#     reachable from outside, the proxy has been bypassed and so has the only
#     authentication in the system.
#   * the trading runtimes listen on nothing at all. They make outbound HTTPS
#     calls to Alpaca and accept no connections; there is no port to expose
#     and no debug endpoint to forget about.
#   * SQLite is a file, not a service. It has no port, and it must not be
#     reached across a network - see docs/DEPLOYMENT.md on why the database
#     directory must be local disk.
#
# If the dashboard is NOT being exposed, leave 80 and 443 closed too. The SSH
# tunnel at the top of this file needs neither.
