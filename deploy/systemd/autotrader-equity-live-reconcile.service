# Reconcile the REAL-MONEY operational store from authoritative broker reads.
#
# This is intentionally a separate, read/repair-only oneshot.  It shares the
# already-audited reconciliation implementation with startup recovery, but it
# does not start the runtime, load either ARM gate, submit, cancel, or replace
# an order.  A failure remains visible to systemd; it is never retried as a
# broker mutation.

[Unit]
Description=AutoTrader reconciliation - equity Live store (Alpaca LIVE, read-only)
Documentation=file:/opt/autotrader-equity-live/app/docs/LIVE_FIRST_DAY_RUNBOOK.md
ConditionPathExists=/etc/autotrader/autotrader-equity-live.env
ConditionPathExists=/opt/autotrader-equity-live/venv/bin/autotrader
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ateqlive
Group=ateqlive
WorkingDirectory=/opt/autotrader-equity-live/app

# Deliberately do not load autotrader-equity-live.arm.env.  Reconciliation
# must work while DISARMED and receives no mutation authorization from this
# unit.
EnvironmentFile=/etc/autotrader/autotrader-equity-live.env
EnvironmentFile=-/etc/autotrader/autotrader-equity-live.secrets.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/autotrader-equity-live/venv/bin/autotrader live reconcile --db ${AUTOTRADER_EQUITY_LIVE_DB}
TimeoutStartSec=300

StateDirectory=autotrader-equity-live
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autotrader-equity-live-reconcile
