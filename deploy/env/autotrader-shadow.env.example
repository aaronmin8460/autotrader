# AutoTrader EQUITY SHADOW - observation only, ZERO ORDER MUTATION.
#
# Install to /etc/autotrader/autotrader-shadow.env (0644 root:root).
#
# This file is deliberately NOT autotrader.env. The shadow shares no
# configuration with the trading runtimes: not the database, not the
# activation flag, not the runtime arguments.
#
# There is no AUTOTRADER_PAPER_TRADING_ENABLED here and there must never be
# one. The shadow has no execution path for it to authorize, and its service
# units do not read /etc/autotrader/autotrader.trading.env at all - the
# atshadow user cannot even open that file.
AUTOTRADER_EQUITY_SHADOW_DB=/var/lib/autotrader-equity-shadow/equity-shadow.db
AUTOTRADER_EQUITY_SHADOW_API_PORT=8001
