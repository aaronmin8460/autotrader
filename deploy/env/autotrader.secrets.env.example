# AutoTrader credentials. NOT A TEMPLATE TO COMMIT FILLED IN.
#
# Install to /etc/autotrader/autotrader.secrets.env
#   owner  root:autotrader
#   mode   0640
#
#   install -o root -g autotrader -m 0640 /dev/null /etc/autotrader/autotrader.secrets.env
#   ${EDITOR:-vi} /etc/autotrader/autotrader.secrets.env
#
# 0640 root:autotrader is the point: the service user can read it, no other
# user on the box can, and the file cannot be rewritten by the account the
# trading processes run as. Verify with `stat -c '%U:%G %a' <file>`.
#
# Write the values with an editor on the server. Do not `echo KEY=... >>` them:
# that puts a live credential in root's shell history, where it outlives the
# session and gets read back by the next person who presses the up arrow.
#
# **These are Alpaca PAPER keys.** They are all this system can use. The
# trading client is constructed with paper=True hardcoded and there is no
# flag, option, or environment variable that selects live trading. A live key
# here does not enable live trading; it makes every broker call fail
# authentication against the paper endpoint.
#
# Nothing in this file is ever read by the frontend. See
# autotrader-dashboard-web.service, which does not load it.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
