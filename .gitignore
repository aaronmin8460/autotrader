# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets / local configuration
.env
.env.local

# Local logs
logs/
*.log

# Local runtime single-instance locks (one per service) and the shared
# account execution lock the two services serialize their order decisions on
*.runtime.lock
*.account.execution.lock

# Local paper-smoke baseline snapshots (autotrader-smoke preflight --write-baseline).
# Operational scratch describing one account at one moment; never committed.
.smoke/

# Local operational trading state (SQLite; introduced in a later phase)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Generated / downloaded market data (keep the directory structure tracked)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Dashboard frontend (C10)
node_modules/
.next/
dashboard/frontend/out/
dashboard/frontend/next-env.d.ts
*.tsbuildinfo

# macOS
.DS_Store
