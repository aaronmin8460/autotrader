#!/usr/bin/env python3
"""Consistent, timestamped, non-destructive backup of the operational database.

**Why this is not `cp autotrader.db`.** The runtimes are 24/7 and the database
is in WAL mode, so at any instant the committed state of the system is spread
across three files: the database, `-wal`, and `-shm`. Copying only the database
file gets a snapshot missing every transaction still in the write-ahead log.
Copying all three with three separate `cp` calls gets three files read at three
different instants, which is worse: the result looks complete and is torn.
`tar`, `rsync` and a filesystem snapshot taken without quiescing have the same
problem for the same reason.

SQLite's online backup API is the supported answer. It copies pages under the
same locking discipline a reader uses, restarts itself if a writer changes a
page mid-copy, and produces a single self-contained file with the WAL already
folded in. The runtimes keep trading throughout, which matters when the
alternative is stopping a 24/7 system once a day to take a copy.

Nothing here writes to the source database, deletes a backup that is not a
backup, or touches the `-wal` and `-shm` files.

Retention is a count, not a schedule: the newest `--keep` files stay and the
rest are removed, oldest first. Scheduling belongs to the systemd timer.
"""

from __future__ import annotations

import argparse
import os
import sqlite3
import sys
from datetime import UTC, datetime
from pathlib import Path

#: Backups are named so that a lexicographic sort is a chronological sort, and
#: so that the name survives being copied off the box without a directory
#: listing to explain it.
FILENAME_PREFIX = "autotrader"
FILENAME_SUFFIX = ".db"
TIMESTAMP_FORMAT = "%Y%m%dT%H%M%SZ"

#: Exit codes. 0 is a completed backup.
BACKUP_FAILED_EXIT_CODE = 1
BACKUP_USAGE_EXIT_CODE = 2


def _timestamp() -> str:
    """UTC, always. The runtimes think in UTC bars; so should their backups."""
    return datetime.now(UTC).strftime(TIMESTAMP_FORMAT)


def _backup_name(stamp: str) -> str:
    return f"{FILENAME_PREFIX}-{stamp}{FILENAME_SUFFIX}"


def _looks_like_backup(path: Path) -> bool:
    """Whether this path is one of ours, by name and by a timestamp that parses.

    Retention deletes files, so it may only ever consider files this script
    created. The test is on the exact name shape rather than on `*.db`: an
    `--into` misconfigured to point at /var/lib/autotrader must not make the
    live database look like an expired backup.
    """
    if not path.is_file():
        return False
    if not path.name.startswith(f"{FILENAME_PREFIX}-") or not path.name.endswith(FILENAME_SUFFIX):
        return False
    stamp = path.name[len(FILENAME_PREFIX) + 1 : -len(FILENAME_SUFFIX)]
    try:
        datetime.strptime(stamp, TIMESTAMP_FORMAT)
    except ValueError:
        return False
    return True


def _prune(directory: Path, keep: int) -> list[Path]:
    """Remove all but the newest `keep` backups. Returns what was removed."""
    if keep <= 0:
        return []
    backups = sorted((p for p in directory.iterdir() if _looks_like_backup(p)), reverse=True)
    removed: list[Path] = []
    for stale in backups[keep:]:
        stale.unlink()
        removed.append(stale)
    return removed


def _run_backup(source: Path, destination: Path) -> None:
    """Copy `source` to `destination` through SQLite's online backup API."""
    # The source is opened read-write. That is not a mistake and it is not a
    # licence to write: the backup API issues no writes to the source, and a
    # WAL database cannot be opened read-only by a process that may have to
    # initialize the shared-memory index. `query_only` makes the read-only
    # intent enforceable rather than merely intended.
    connection = sqlite3.connect(source, timeout=30.0)
    try:
        connection.execute("PRAGMA query_only = ON")
        target = sqlite3.connect(destination)
        try:
            # `pages=-1` copies the whole database in one step while holding a
            # read lock, which is the right trade for a database this size: it
            # is the shortest window and it cannot be restarted by a writer
            # part-way through.
            connection.backup(target, pages=-1)
            target.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        finally:
            target.close()
    finally:
        connection.close()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="autotrader-backup",
        description=(
            "Back up the AutoTrader operational database using SQLite's online "
            "backup API. Safe to run while the runtimes are trading."
        ),
    )
    parser.add_argument("--db", required=True, help="Source database.")
    parser.add_argument("--into", required=True, help="Directory to write backups into.")
    parser.add_argument(
        "--keep",
        type=int,
        default=7,
        help="How many backups to retain, newest first (default 7). 0 keeps everything.",
    )
    arguments = parser.parse_args(argv)

    source = Path(arguments.db)
    directory = Path(arguments.into)

    if not source.is_file():
        print(f"No database at {source}. Nothing to back up.", file=sys.stderr)
        return BACKUP_FAILED_EXIT_CODE

    directory.mkdir(parents=True, exist_ok=True)
    os.chmod(directory, 0o750)

    destination = directory / _backup_name(_timestamp())
    if destination.exists():
        print(f"{destination} already exists; refusing to overwrite it.", file=sys.stderr)
        return BACKUP_FAILED_EXIT_CODE

    # A partial file left by a failed backup would be indistinguishable from a
    # good one at restore time, so failure removes it.
    try:
        _run_backup(source, destination)
    except (sqlite3.Error, OSError) as error:
        destination.unlink(missing_ok=True)
        print(f"Backup failed: {error}", file=sys.stderr)
        return BACKUP_FAILED_EXIT_CODE

    os.chmod(destination, 0o640)
    size = destination.stat().st_size
    print(f"Backed up {source} -> {destination} ({size} bytes)")

    for removed in _prune(directory, arguments.keep):
        print(f"Pruned {removed}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
