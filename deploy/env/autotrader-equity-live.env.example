# AutoTrader Equity EDA-1 REAL-MONEY VALIDATION - shared, non-secret config.
#
# Install to /etc/autotrader/autotrader-equity-live.env
#   owner  root:root
#   mode   0644
#
# World-readable on purpose: everything here is a path, a policy name, a port
# or a SAFE DEFAULT, and keeping the credentials somewhere else is what lets
# this file be reviewed casually. The account fingerprint below is a one-way
# digest and is safe to read; the account number itself is not written here
# because the check does not need it.
#
# systemd parses this itself, not a shell. `KEY=value`, one per line, no
# `export`, no command substitution, no expansion of one variable into another.

# ---------------------------------------------------------------------------
# Stores
# ---------------------------------------------------------------------------

# This runtime's OWN operational database. Never the paper store, never the
# shadow store, never the crypto store. A real-money order intent and a paper
# order intent must not be able to appear in one table.
AUTOTRADER_EQUITY_LIVE_DB=/var/lib/autotrader-equity-live/equity-live.db

# Flow-adjusted accounting is a separate schema in the same dedicated state
# directory. Neither this file nor the Live runtime treats it as trading cash.
AUTOTRADER_LIVE_ACCOUNTING_DB=/var/lib/autotrader-equity-live/live-accounting.db

# The shadow store, read-only, for the decision parity check. Opened with a
# read-only URI and a single SELECT, never through the normal open path.
AUTOTRADER_EQUITY_SHADOW_DB=/var/lib/autotrader-equity-shadow/equity-shadow.db

# ---------------------------------------------------------------------------
# The account pin
# ---------------------------------------------------------------------------
#
# A SHA-256 digest of the account number this runtime is authorized to operate,
# truncated to 32 hex characters. Generate it during the read-only verification
# pass and paste it here.
#
# There is no unpinned mode. An empty value, a malformed value, or an account
# that answers with a different fingerprint each stop the runtime before it
# fetches a single bar. This is what makes a rotated credential, a secrets file
# copied from another host, or a second account opened for something else fail
# loudly instead of being traded.
AUTOTRADER_LIVE_ACCOUNT_FINGERPRINT=

# ---------------------------------------------------------------------------
# The validation policy
# ---------------------------------------------------------------------------
#
# The frozen allocation policy. The runtime has no default and refuses to start
# without one: a default here would be a sizing policy nobody selected.
#
# LIVE_VALIDATION_100 is the validated paper champion under a spending limit -
# every percentage unchanged, plus absolute ceilings of $90 target, $95 hard,
# $11 per symbol, $100 authorized. Each ceiling binds as the tighter of its
# percentage and its dollar figure, so a partly funded account is limited by
# its balance and a grown one is limited by the authorization.
AUTOTRADER_EQUITY_LIVE_SIZING_POLICY=LIVE_VALIDATION_100

# The rollout stage, which selects the EXECUTION universe. The decision
# universe is always all ten. A host that has been deployed but never
# deliberately advanced runs at A.
#
#   A  SPY
#   B  SPY, QQQ, IWM
#   C  all ten
AUTOTRADER_EQUITY_LIVE_STAGE=A

# ---------------------------------------------------------------------------
# THE SAFE DEFAULTS
# ---------------------------------------------------------------------------
#
# The environment half of the two-gate arm. The code accepts exactly the string
# `true` and treats missing, empty, `TRUE`, `1`, `yes` and anything else as
# disarmed, so a typo can only ever fail closed.
#
# Do not edit this to arm the runtime. Arming lives in
# /etc/autotrader/autotrader-equity-live.arm.env, which the unit loads after
# this file, because the off switch is deleting that file and it cannot delete
# a `true` written here.
#
# This gate is only half of the arm. The other half is a durable row in the
# operational store, flipped with the CLI. Neither can satisfy the other.
AUTOTRADER_LIVE_ARMED=false

# Display-only readiness, consumed by the read-only APIs. It is never imported
# by the execution path and grants no mutation permission. Production changes
# this to true only after every deployment gate in the runbook passes.
AUTOTRADER_LIVE_READY=false

# Runtime identity acknowledgement and data-publication delay. This permits a
# DISARMED observer process to start; it does NOT satisfy either mutation gate.
AUTOTRADER_EQUITY_LIVE_ARGS=--confirm-runtime-environment REAL-MONEY --safety-delay 120

# Dashboard APIs, loopback only. Distinct from the paper API's 8002.
AUTOTRADER_LIVE_ACCOUNTING_API_PORT=8005
AUTOTRADER_LIVE_SAFETY_API_PORT=8006

# Replaced with the exact committed SHA during production installation. It is
# display/audit provenance and is never used as permission to trade.
AUTOTRADER_DEPLOYED_SHA=
