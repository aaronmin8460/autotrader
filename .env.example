# Copy to .env and fill in locally. Never commit .env.
#
# Phase 0 does NOT connect to Alpaca. No credentials are read, required, or
# used by any code in this repository yet. These placeholders exist only so
# the intended configuration surface is documented up front.
#
# ALPACA_PAPER must remain true. Live trading is out of scope (docs/SPEC.md).

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
