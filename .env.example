# Copy to .env and fill in locally. Never commit .env.
#
# These credentials are used for historical market-data download only
# (`autotrader.cli download`). No trading execution exists in this repository:
# nothing here submits an order, paper or live, and no broker trading client
# is constructed. ALPACA_PAPER is not read by any code yet.
#
# ALPACA_PAPER must remain true. Live trading is out of scope (docs/SPEC.md).

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
