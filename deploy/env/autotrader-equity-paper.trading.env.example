# The ACTIVATION file for the Equity EDA-1 PAPER runtime.
#
# Install to /etc/autotrader/autotrader-equity-paper.trading.env
#   owner  root:root
#   mode   0644
#
# The unit loads this after autotrader-equity-paper.env, so these override the
# safe defaults there. Delete this file to return the runtime to refusing to
# start - which is why the gate lives here and not in the shared file: the off
# switch has to be able to act on the same file the on switch wrote.
#
# There is no live counterpart to any of this. The repository contains exactly
# one TradingClient construction and it hardcodes paper=True.
AUTOTRADER_PAPER_TRADING_ENABLED=true
AUTOTRADER_EQUITY_PAPER_ARGS=--confirm-paper-runtime PAPER
