# Public web publish configuration for the AutoTrader dashboard.
#
# Install to /etc/autotrader/autotrader.web.env
#   owner  root:caddy
#   mode   0640
#
# **Unlike autotrader.env, this file is not world-readable**, and the mode is
# the point. autotrader.env can be reviewed casually because everything in it
# is a path, a port or a safe default. This one holds the bcrypt hash that is
# the dashboard's entire authentication boundary; a hash is not a password,
# but handing every local account an offline cracking target for the only
# credential in the system is not a trade worth making for a `cat`.
#
# systemd parses this itself, not a shell. `KEY=value`, one per line, no
# `export`, no command substitution, no expansion of one variable into
# another. It reaches Caddy through the drop-in at
# deploy/systemd/caddy.service.d/10-autotrader-web.conf.
#
# `autotrader-publish-web` writes this file. It ships empty for the same
# reason autotrader.secrets.env does: a template with a working credential in
# it is a credential in Git.

# The public hostname. Caddy provisions a certificate for exactly this name
# over ACME, so it must already resolve to this host's public address before
# the service starts — see docs/DEPLOYMENT.md, "Publishing the dashboard".
AUTOTRADER_DASHBOARD_DOMAIN=

# The login name. Not a secret, and not a defence: it is the other half of a
# credential whose strength is entirely in the password.
AUTOTRADER_DASHBOARD_USER=

# A bcrypt hash, generated on this host with `caddy hash-password`. The
# plaintext is never written down anywhere on the machine.
#
# Empty is safe. Caddy substitutes the empty string for an unset variable, and
# an empty hash matches no password, so a half-configured host refuses every
# login rather than accepting any.
AUTOTRADER_DASHBOARD_PASSWORD_HASH=
